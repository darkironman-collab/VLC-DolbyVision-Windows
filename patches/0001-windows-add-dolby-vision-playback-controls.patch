+static bool UseMFTForDolbyVision(decoder_t *p_dec)
+{
+    if (!vlc_es_format_IsDolbyVision(p_dec->fmt_in))
+        return true;
+    if (!var_InheritBool(p_dec, "dovi-decoding"))
+        return false;
+
+    switch (var_InheritInteger(p_dec, "dovi-decode-mode"))
+    {
+        case VLC_DOVI_DECODE_AUTO:
+            return var_InheritBool(p_dec, "dovi-use-codec-extensions");
+        case VLC_DOVI_DECODE_MICROSOFT:
+        case VLC_DOVI_DECODE_CODEC_EXTENSION:
+            return true;
+        case VLC_DOVI_DECODE_FFMPEG_HW:
+        case VLC_DOVI_DECODE_SOFTWARE:
+        default:
+            return false;
+    }
+}
+
+static int OpenDovi(vlc_object_t *p_this)
+{
+    decoder_t *p_dec = (decoder_t *)p_this;
+    if (!vlc_es_format_IsDolbyVision(p_dec->fmt_in) ||
+        !UseMFTForDolbyVision(p_dec))
+        return VLC_EGENERIC;
+    return Open(p_this);
+}
+
 static int Open(vlc_object_t *p_this)
 {
     decoder_t *p_dec = (decoder_t *)p_this;
 
+    if (!UseMFTForDolbyVision(p_dec))
+        return VLC_EGENERIC;
+
     if( FAILED(CoInitializeEx(NULL, COINIT_MULTITHREADED | COINIT_DISABLE_OLE1DDE)) )
         return VLC_EINVAL;
 
