+static void PrepareDecoderOutputFormat(decoder_t *p_dec)
+{
+    if (p_dec->fmt_in->i_cat != VIDEO_ES)
+    {
+        p_dec->fmt_out.audio = p_dec->fmt_in->audio;
+        return;
+    }
+
+    video_format_Copy(&p_dec->fmt_out.video, &p_dec->fmt_in->video);
+    if (vlc_es_format_IsDolbyVision(p_dec->fmt_in))
+    {
+        if (p_dec->fmt_out.video.dovi.version_major == 0)
+            p_dec->fmt_out.video.dovi.version_major = 1;
+        vlc_video_format_ApplyDoviProfileOverride(
+            &p_dec->fmt_out.video,
+            var_InheritInteger(p_dec, "dovi-force-profile"));
+    }
+}
+
+static HRESULT SelectDecoderOutputType(decoder_t *p_dec)
+{
+    auto *p_sys = static_cast<mft_sys_t *>(p_dec->p_sys);
+    PrepareDecoderOutputFormat(p_dec);
+
+    if (p_dec->fmt_in->i_cat != VIDEO_ES ||
+        !vlc_es_format_IsDolbyVision(p_dec->fmt_in))
+        return p_sys->SetOutputType(vlc_object_logger(p_dec), GUID_NULL,
+                                    p_dec->fmt_out);
+
+    HRESULT hr = p_sys->SetOutputType(vlc_object_logger(p_dec),
+                                      MFVideoFormat_P010, p_dec->fmt_out);
+    if (SUCCEEDED(hr))
+    {
+        msg_Info(p_dec, "Dolby Vision Media Foundation output selected: P010 10-bit");
+        return hr;
+    }
+
+    if (!var_InheritBool(p_dec, "dovi-hdr10-fallback"))
+        return hr;
+
+    msg_Warn(p_dec, "P010 output unavailable; trying compatible Media Foundation fallback");
+    return p_sys->SetOutputType(vlc_object_logger(p_dec), GUID_NULL,
+                                p_dec->fmt_out);
