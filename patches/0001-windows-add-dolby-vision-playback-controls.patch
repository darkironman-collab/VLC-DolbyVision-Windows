index 0000000000000000000000000000000000000000..d78cded67599cb31c3d7c97a604186a3aa176fdc
--- /dev/null
+++ b/dolbyvision/verify_dovi_sources.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Fail CI when a required Windows Dolby Vision integration point is absent."""
+
+from pathlib import Path
+
+
+REQUIRED = {
+    "include/vlc_dovi.h": [
+        "VLC_DOVI_DECODE_CODEC_EXTENSION",
+        "VLC_DOVI_PROFILE_8_1",
+        "vlc_video_format_ApplyDoviProfileOverride",
+    ],
+    "include/vlc_es.h": ["bl_compatibility_id : 4"],
+    "modules/codec/mft.cpp": [
+        "{ VLC_CODEC_HEVC, MFVideoFormat_HEVC },",
+        "{ VLC_CODEC_P010,  MFVideoFormat_P010 },",
+        "static int OpenDovi",
+        "SelectDecoderOutputType",
+        "MFVideoFormat_P010",
+        "Dolby Vision RPU NAL detected",
+        "require_dolby_transform",
+    ],
+    "modules/codec/avcodec/video.c": [
+        "b_dovi_force_software",
+        "b_dovi_force_hardware",
+        "dovi-force-profile",
+    ],
+    "modules/gui/qt/menus/menus.cpp": [
+        "AddDolbyVisionMenu",
+        "Force Dolby Vision profile",
+        "Show Dolby Vision popup",
+    ],
+    "src/libvlc-module.c": [
+        'add_integer( "dovi-decode-mode"',
+        'add_integer( "dovi-force-profile"',
+        'add_bool( "dovi-hdr10-fallback"',
+    ],
+    "src/video_output/video_output.c": [
+        'var_InheritBool(&vout->obj, "dovi-osd")',
+        "vlc_dovi_ProfileName",
+    ],
+    "modules/demux/mp4/libmp4.c": ["i_bl_compatibility_id"],
+    "modules/demux/avformat/demux.c": [
+        "dv_bl_signal_compatibility_id"
+    ],
+}
+
+
+def main() -> None:
+    missing: list[str] = []
+    for filename, markers in REQUIRED.items():
+        text = Path(filename).read_text(encoding="utf-8")
+        for marker in markers:
+            if marker not in text:
+                missing.append(f"{filename}: {marker}")
+
+    if missing:
+        raise SystemExit("Missing Dolby Vision integration markers:\n- " +
+                         "\n- ".join(missing))
+    print(f"Verified {sum(map(len, REQUIRED.values()))} Dolby Vision integration markers")
+
+
+if __name__ == "__main__":
+    main()
