+static void ReportDolbyVisionConfig(decoder_t *p_dec, mft_dec_video *vidsys)
+{
+    if (vidsys->b_dovi_config_reported ||
+        !vlc_es_format_IsDolbyVision(p_dec->fmt_in))
+        return;
+
+    video_format_t fmt = p_dec->fmt_in->video;
+    if (fmt.dovi.version_major == 0)
+        fmt.dovi.version_major = 1;
+    vlc_video_format_ApplyDoviProfileOverride(
+        &fmt, var_InheritInteger(p_dec, "dovi-force-profile"));
+
+    msg_Info(p_dec,
+             "Dolby Vision configuration detected: %s, profile=%u level=%u "
+             "BL-compatibility-id=%u RPU=%s EL=%s BL=%s config-version=%u.%u",
+             vlc_dovi_ProfileName(&fmt), fmt.dovi.profile, fmt.dovi.level,
+             fmt.dovi.bl_compatibility_id,
+             fmt.dovi.rpu_present ? "yes" : "no",
+             fmt.dovi.el_present ? "yes" : "no",
+             fmt.dovi.bl_present ? "yes" : "no",
+             fmt.dovi.version_major, fmt.dovi.version_minor);
+    vidsys->b_dovi_config_reported = true;
+}
+
+static bool AnnexBHasDolbyVisionRpu(const block_t *block)
+{
+    if (block == nullptr || block->p_buffer == nullptr || block->i_buffer < 6)
+        return false;
+
+    const uint8_t *p = block->p_buffer;
+    const size_t size = block->i_buffer;
+
+    for (size_t i = 0; i + 5 < size; ++i)
+    {
+        size_t nal = 0;
+        if (p[i] == 0 && p[i + 1] == 0 && p[i + 2] == 1)
+            nal = i + 3;
+        else if (i + 4 < size && p[i] == 0 && p[i + 1] == 0 &&
+                 p[i + 2] == 0 && p[i + 3] == 1)
+            nal = i + 4;
+        else
+            continue;
+
+        if (nal + 1 >= size)
+            continue;
+
+        const unsigned nal_unit_type = (p[nal] >> 1) & 0x3f;
+        if (nal_unit_type == 62)
+            return true;
+    }
+    return false;
+}
+
+static int PrepareH26xInput(decoder_t *p_dec, block_t **pp_block)
+{
+    if (p_dec->fmt_in->i_codec != VLC_CODEC_H264 &&
+        p_dec->fmt_in->i_codec != VLC_CODEC_HEVC)
+        return VLC_SUCCESS;
+
+    auto *p_sys = static_cast<mft_sys_t *>(p_dec->p_sys);
+    auto *vidsys = dynamic_cast<mft_dec_video *>(p_sys);
+    *pp_block = hxxx_helper_process_block(&vidsys->hh, *pp_block);
+    block_t *p_block = *pp_block;
+
+    if (p_dec->fmt_in->i_codec == VLC_CODEC_HEVC && p_block != nullptr &&
+        !vidsys->b_dovi_rpu_seen && AnnexBHasDolbyVisionRpu(p_block))
+    {
+        vidsys->b_dovi_rpu_seen = true;
+        p_dec->fmt_out.video.dovi.version_major =
+            p_dec->fmt_out.video.dovi.version_major != 0
+            ? p_dec->fmt_out.video.dovi.version_major : 1;
+        p_dec->fmt_out.video.dovi.rpu_present = 1;
+        vlc_video_format_ApplyDoviProfileOverride(
+            &p_dec->fmt_out.video,
+            var_InheritInteger(p_dec, "dovi-force-profile"));
+        msg_Info(p_dec, "Dolby Vision RPU NAL detected in HEVC stream (NAL unit type 62)");
+    }
+
+    if (vidsys->hh.i_input_nal_length_size && !vidsys->b_xps_pushed)
+    {
+        block_t *p_xps_blocks = hxxx_helper_get_extradata_block(&vidsys->hh);
+        if (p_xps_blocks)
+        {
+            if (p_block == nullptr)
+            {
+                block_ChainRelease(p_xps_blocks);
+                return VLC_EGENERIC;
+            }
+
+            const vlc_tick_t pts = p_block->i_pts;
+            const vlc_tick_t dts = p_block->i_dts;
+            const vlc_tick_t length = p_block->i_length;
+            const unsigned flags = p_block->i_flags;
+            block_ChainAppend(&p_xps_blocks, p_block);
+            p_block = block_ChainGather(p_xps_blocks);
+            *pp_block = p_block;
+            if (p_block == nullptr)
+                return VLC_ENOMEM;
+
+            p_block->i_pts = pts;
+            p_block->i_dts = dts;
+            p_block->i_length = length;
+            p_block->i_flags = flags;
+            vidsys->b_xps_pushed = true;
+        }
+    }
+
+    return VLC_SUCCESS;
+}
