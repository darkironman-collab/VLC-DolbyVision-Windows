+static QAction *AddDolbyVisionToggle(QMenu *menu, qt_intf_t *p_intf,
+                                     const QString &label,
+                                     const char *config_name,
+                                     bool restart_decoder = true)
+{
+    QAction *action = menu->addAction(label);
+    action->setCheckable(true);
+    action->setChecked(config_GetInt(config_name) != 0);
+    QObject::connect(action, &QAction::toggled, menu,
+                     [p_intf, config_name, restart_decoder](bool checked) {
+        config_PutInt(config_name, checked);
+        if (restart_decoder)
+            RestartDolbyVisionVideoDecoder(p_intf);
+    });
+    return action;
+}
