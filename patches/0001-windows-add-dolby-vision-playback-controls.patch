index 0000000000000000000000000000000000000000..7dc5d5bb3a7e7fc94b054a2cd109ac4e206383df
--- /dev/null
+++ b/include/vlc_dovi.h
@@ -0,0 +1,116 @@
+/*****************************************************************************
+ * vlc_dovi.h: shared Dolby Vision playback policy helpers
+ *****************************************************************************
+ * Copyright (C) 2026 VLC-DolbyVision contributors
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *****************************************************************************/
+
+#ifndef VLC_DOVI_H
+#define VLC_DOVI_H 1
+
+#include <vlc_es.h>
+
+/** Values stored by the global ``dovi-decode-mode`` preference. */
+enum vlc_dovi_decode_mode
+{
+    VLC_DOVI_DECODE_AUTO = 0,
+    VLC_DOVI_DECODE_MICROSOFT = 1,
+    VLC_DOVI_DECODE_CODEC_EXTENSION = 2,
+    VLC_DOVI_DECODE_FFMPEG_HW = 3,
+    VLC_DOVI_DECODE_SOFTWARE = 4,
+};
+
+/** Values stored by the global ``dovi-force-profile`` preference. */
+enum vlc_dovi_profile_override
+{
+    VLC_DOVI_PROFILE_AUTO = 0,
+    VLC_DOVI_PROFILE_4 = 4,
+    VLC_DOVI_PROFILE_5 = 5,
+    VLC_DOVI_PROFILE_7 = 7,
+    VLC_DOVI_PROFILE_8_1 = 81,
+    VLC_DOVI_PROFILE_8_2 = 82,
+    VLC_DOVI_PROFILE_8_4 = 84,
+    VLC_DOVI_PROFILE_9 = 9,
+};
+
+static inline bool vlc_video_format_IsDolbyVision(const video_format_t *fmt)
+{
+    return fmt != NULL && (fmt->dovi.version_major != 0 ||
+                           fmt->dovi.profile != 0 ||
+                           fmt->dovi.rpu_present != 0);
+}
+
+static inline bool vlc_es_format_IsDolbyVision(const es_format_t *fmt)
+{
+    if (fmt == NULL || fmt->i_cat != VIDEO_ES)
+        return false;
+
+    if (vlc_video_format_IsDolbyVision(&fmt->video))
+        return true;
+
+    const vlc_fourcc_t tag = fmt->i_original_fourcc != 0
+                           ? fmt->i_original_fourcc : fmt->i_codec;
+    return tag == VLC_FOURCC('d', 'v', 'h', 'e') ||
+           tag == VLC_FOURCC('d', 'v', 'h', '1') ||
+           tag == VLC_FOURCC('d', 'v', 'a', '1') ||
+           tag == VLC_FOURCC('d', 'v', 'a', 'v');
+}
+
+static inline void
+vlc_video_format_ApplyDoviProfileOverride(video_format_t *fmt, int value)
+{
+    if (fmt == NULL || value == VLC_DOVI_PROFILE_AUTO)
+        return;
+
+    fmt->dovi.version_major = fmt->dovi.version_major != 0
+                            ? fmt->dovi.version_major : 1;
+    fmt->dovi.bl_compatibility_id = 0;
+
+    switch (value)
+    {
+        case VLC_DOVI_PROFILE_8_1:
+            fmt->dovi.profile = 8;
+            fmt->dovi.bl_compatibility_id = 1;
+            break;
+        case VLC_DOVI_PROFILE_8_2:
+            fmt->dovi.profile = 8;
+            fmt->dovi.bl_compatibility_id = 2;
+            break;
+        case VLC_DOVI_PROFILE_8_4:
+            fmt->dovi.profile = 8;
+            fmt->dovi.bl_compatibility_id = 4;
+            break;
+        default:
+            fmt->dovi.profile = value;
+            break;
+    }
+}
+
+static inline const char *vlc_dovi_ProfileName(const video_format_t *fmt)
+{
+    if (fmt == NULL)
+        return "Dolby Vision";
+
+    switch (fmt->dovi.profile)
+    {
+        case 4: return "Dolby Vision Profile 4";
+        case 5: return "Dolby Vision Profile 5";
+        case 7: return "Dolby Vision Profile 7";
+        case 8:
+            switch (fmt->dovi.bl_compatibility_id)
+            {
+                case 1: return "Dolby Vision Profile 8.1";
+                case 2: return "Dolby Vision Profile 8.2";
+                case 4: return "Dolby Vision Profile 8.4";
+                default: return "Dolby Vision Profile 8";
+            }
+        case 9: return "Dolby Vision Profile 9";
+        default: return "Dolby Vision";
+    }
+}
+
+#endif /* VLC_DOVI_H */
